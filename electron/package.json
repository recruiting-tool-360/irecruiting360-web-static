{
  "name": "electron",
  "version": "1.0.0",
  "description": "i快招智能招聘助手 - 桌面客户端 (dev 包名保持 electron 不动以避免 userData 路径漂移；生产 .app 名由 electron-builder.yml 的 productName 决定)",
  "main": "./out/main/index.js",
  "author": "ihire365.com",
  "homepage": "https://ihire365.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "build:icons": "electron-icon-builder --input=./resources/icon.png --output=./resources --flatten",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:mac:dev": "electron-vite build && electron-builder --mac --config.mac.identity=null --config.mac.notarize=false",
    "build:win:dev": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= npm run build && electron-builder --win",
    "build:mac:dir": "electron-vite build && electron-builder --mac --dir --config.mac.identity=null",
    "build:win:dir": "npm run build && electron-builder --win --dir --config.win.signtoolOptions=null",
    "build:mac:release": "node ./scripts/check-release-env.js mac && bash ./scripts/verify-p12.sh && electron-vite build && electron-builder --mac --config.mac.notarize=true",
    "build:mac:release:arm64": "node ./scripts/check-release-env.js mac && bash ./scripts/verify-p12.sh && electron-vite build && electron-builder --mac --arm64 --config.mac.notarize=true",
    "build:mac:release:x64": "node ./scripts/check-release-env.js mac && bash ./scripts/verify-p12.sh && electron-vite build && electron-builder --mac --x64 --config.mac.notarize=true",
    "build:win:release": "node ./scripts/check-release-env.js win && npm run build && electron-builder --win",
    "publish:cos": "node ./scripts/publish-cos.js",
    "publish:cos:win": "node ./scripts/publish-cos.js --platform win",
    "publish:cos:mac": "node ./scripts/publish-cos.js --platform mac",
    "publish:cos:dry": "node ./scripts/publish-cos.js --dry-run",
    "publish:cos:check": "node ./scripts/publish-cos.js --check"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.3.9",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "cross-env": "^10.1.0",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  }
}
