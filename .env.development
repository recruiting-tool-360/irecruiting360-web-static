NODE_ENV=development

# ihire-solution 后端 API base URL
# 用**相对路径** /web-manage-api，让所有请求走 dev server 本域（localhost:8080），
# 再由 quasar.config.js 的 devServer.proxy 反向代理到测试服域名，绕开浏览器 CORS。
# 测试服域名在 quasar.config.js 里集中维护（VUE_APP_DEV_API_TARGET），切换 test/qa/prod 改一处即可。
VUE_APP_API_BASE_URL=/web-manage-api

# 仅 dev：proxy 把 VUE_APP_API_BASE_URL 转发到这个绝对地址。
# 切到其它环境（qa / sit）改这里即可。
VUE_APP_DEV_API_TARGET=https://test.ihire365.com

VUE_APP_WECHAT_CALL_URL=http://127.0.0.1:8080
VUE_APP_WECHAT_APP_ID=wxbb2e4e12c34aa9e2